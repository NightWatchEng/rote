# Copy to .env (gitignored). `cua` reads it on start; real environment variables win.

# Model access, needed only for `cua discover`. Replay never calls a model.
# Leave empty to use the `claude` CLI login instead (--backend claude-cli).
ANTHROPIC_API_KEY=

# Operator credentials for each tenant, as named by tenants/*.json.
# These are the MeridianCore SIMULATOR's built-in demo credentials, not real ones.
PINECREST_OPERATOR_ID=TELLER01
PINECREST_OPERATOR_PASSWORD=demo-teller-pass
LAKESHORE_OPERATOR_ID=TELLER01
LAKESHORE_OPERATOR_PASSWORD=demo-teller-pass
